# backend 폴더에서 이 파일을 복사해 .env 를 만든 뒤 값을 채우세요 (.env는 커밋 금지)
# 값에 따옴표("")를 붙이지 마세요
# 프론트엔드 키(VITE_*)는 frontend/.env 에 따로 넣습니다

# DB (docker-compose + Spring 공용)
DB_NAME=ai_youth_pjt_db
DB_USER=postgres
DB_PASSWORD=

# pgAdmin (선택: docker compose --profile tools up -d)
PGADMIN_EMAIL=
PGADMIN_PASSWORD=

# 외부 API
KAKAO_REST_API_KEY=
ODSAY_WEB_KEY=

# 공고문 질문 Python RAG 서비스 (프롬프트·검색·LLM 호출은 Python 쪽)
RAG_SERVICE_ENABLED=false
RAG_SERVICE_URL=http://localhost:8000
# 응답 대기 한도. 프론트 로딩 기준과 같은 15초
RAG_SERVICE_TIMEOUT=15s

# LLM (Python RAG 서비스가 사용)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
