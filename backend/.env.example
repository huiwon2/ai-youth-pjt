# backend 폴더에서 이 파일을 복사해 .env 를 만든 뒤 값을 채우세요 (.env는 커밋 금지)
# 값에 따옴표("")를 붙이지 마세요
# 프론트엔드 키(VITE_*)는 frontend/.env 에 따로 넣습니다

# DB (docker-compose + Spring 공용)
DB_NAME=ai_youth_pjt_db
DB_USER=postgres
DB_PASSWORD=

# pgAdmin (선택: docker compose --profile tools up -d)
PGADMIN_EMAIL=
PGADMIN_PASSWORD=

# 외부 API
KAKAO_REST_API_KEY=
ODSAY_WEB_KEY=

# 내부 HTTP 서비스
RAG_SERVICE_ENABLED=true
RAG_SERVICE_URL=http://localhost:8000
RAG_SERVICE_TIMEOUT=15s
RECOMMENDATION_SERVICE_URL=http://localhost:8001
# 모델 키와 RAG의 DATABASE_URL은 rag/.env에 설정합니다.
